{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stage Ingest",
  "version": "0.1.0",
  "identifier": "ch.filmstudiobasel.stage-ingest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stage Ingest",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "publisher": "Filmstudio Basel",
    "homepage": "https://github.com/casebasel/stage-ingest",
    "shortDescription": "Kamerakarten geprüft kopieren",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
